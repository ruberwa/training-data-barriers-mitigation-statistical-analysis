    family-names: RUBERWA
    orcid: "https://orcid.org/0009-0005-5318-5656"
repository-code: "https://github.com/ruberwa/training-data-barriers-statistical-analysis"
license: MIT
version: "1.0.0"
date-released: "2026-11-19"
keywords:
  - systematic review
  - quantitative synthesis
  - weed detection
  - training data
  - computer vision
  - reproducibility
